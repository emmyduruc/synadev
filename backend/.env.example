# =============================================================================
# SYNA backend (@syna/backend) — environment template
# Copy to `backend/.env` OR set the same keys in the repo-root `.env`.
#   cp backend/.env.example backend/.env
#
# Nest loads (first existing): cwd/.env → ../.env → backend/.env → root .env
# =============================================================================

# --- Server ------------------------------------------------------------------
# Required — Clerk secret key (sk_test_… / sk_live_…) for JWT verification
CLERK_SECRET_KEY=

# Optional (default: 3000)
PORT=3000

# Optional
NODE_ENV=development

# Optional — disabled when false or when NODE_ENV=production
SWAGGER_ENABLED=true

# --- Database (required to boot DatabaseModule) ------------------------------
# Pooled / runtime URL
DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require

# Direct URL for migrations (data-source.ts)
DIRECT_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# Optional (default: false) — true | false only
DATABASE_SYNCHRONIZE=false

# --- Email / Resend (required when calling email endpoints) ------------------
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=noreply@example.com

# Optional (default: SYNA)
RESEND_FROM_NAME=SYNA

# --- OpenAI / SYNA chat (required for POST /chat) ----------------------------
OPENAI_API_KEY=sk-xxxxxxxx

# Optional (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
