# =============================================================================
# SYNA — monorepo environment template
# Copy to `.env` at the repo root (preferred) and fill in real values.
#   cp .env.example .env
#
# Backend also accepts `backend/.env`. Client also accepts `client/.env`.
# Prefer a single root `.env` so Nest and Expo both pick it up.
# =============================================================================

# --- Client (Expo) -----------------------------------------------------------
# Required — Clerk publishable key (pk_test_… / pk_live_…)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional — Nest API base URL (default: http://localhost:3000)
# Android emulator: http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# --- Backend (NestJS) --------------------------------------------------------
# Required — Clerk secret key for verifying session JWTs on the API (sk_test_… / sk_live_…)
CLERK_SECRET_KEY=

# Optional — HTTP listen port (default: 3000)
PORT=3000

# Optional — development | production | test
NODE_ENV=development

# Optional — set to false to disable Swagger (also off when NODE_ENV=production)
SWAGGER_ENABLED=true

# Required — Postgres connection (pooled / runtime, e.g. Supabase pooler :6543)
DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require

# Required — Postgres direct URL for TypeORM migrations (e.g. session :5432)
DIRECT_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# Optional — TypeORM synchronize (default: false). Never use true in production.
DATABASE_SYNCHRONIZE=false

# Required when sending email (Resend) — validated on first send
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=noreply@example.com

# Optional — sender display name (default: SYNA)
RESEND_FROM_NAME=SYNA
