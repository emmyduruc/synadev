# =============================================================================
# SYNA client (@syna/client) — environment template
# Prefer setting these in the repo-root `.env` (Expo + Clerk look there first).
# You can also copy this file:
#   cp client/.env.example client/.env
# =============================================================================

# Required — Clerk publishable key
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional — Nest API base URL (default: http://localhost:3000)
# Android emulator: http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
