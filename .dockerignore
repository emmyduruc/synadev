# Git / IDE
.git
.github
.cursor
.vscode
.idea
**/.DS_Store

# Dependencies & build outputs (rebuilt in image)
**/node_modules
**/.turbo
**/dist
**/coverage
**/*.tsbuildinfo
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/releases/**
!.yarn/sdks
!.yarn/versions

# Env / secrets
.env
.env.*
!.env.example
!**/.env.example

# Client / mobile (not needed for backend image)
client/ios
client/android
client/.expo
client/.expo-shared
**/*.log

# Docs / tests not required at runtime
**/README.md
backend/test
**/*.spec.ts
**/*.md
!backend/package.json

# Local tooling
husky
lint-staged*
